<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error Page</title>

    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="error-container">
        <h1>Oops! an error occurred.</h1>
        <h3>Error: <%= error.status || 500 %></h3>
        <h3><%= error.message %></h3>

        <a style="align-items: center;" href="<%= link || '/' %>"><%=linkMessage || 'Go Back To Login' %></a>
    </div>
</body>
</html>