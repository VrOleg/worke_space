<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SignUp</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="navbar">
        <a href="home">Home</a>
        <a href="login">Login</a>
        <a href="signup">Signup</a>
        <a href="api-docs">API</a>
    </div>

    <div class="form-container">
        <h2>SignUp</h2>
        <form action="/signup" method="post">
            <div class="form-group">
                <label for="email">Email:</label>
                <label id="error-label-email" class="error-message" style="display: none;">*Wrong email format</label>
                <input type="text" name="userEmail" id="email" class="form-control" placeholder="Enter your email"
                    autocomplete="off">
            </div>
            <div class="form-group">
                <label id="error-label-password" class="error-message" style="display: none;">*Password must have at list 6 digit</label>
                <label for="password">Password:</label>
                <input type="password" name="password" id="password" placeholder="password" required>
            </div>
            <div class="form-group">
                <label for="phon">Phone:</label>
                <input type="tel" name="phone" id="phone" placeholder="05x-xxxxxxx" pattern="[0-9]{10}">
            </div>
            <button type="submit" class="submit-btn">SingUp</button>
        </form>
    </div>
</body>

</html>